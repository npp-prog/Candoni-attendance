# --- Firebase web app config (Firebase console → Project settings → Your apps) ---
# These identify your Firebase project; they are not secrets. Access is enforced by
# Firestore rules, backend functions and (optionally) App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Organization id used for sign-in branding (must match the bootstrap script --org).
VITE_ORG_ID=candoni
# Region where Cloud Functions are deployed (must match functions/.env FUNCTIONS_REGION).
VITE_FUNCTIONS_REGION=asia-southeast1

# Optional: Firebase App Check with reCAPTCHA Enterprise site key. Leave empty to disable.
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

# Local development against the Firebase Emulator Suite. Never "true" in production.
VITE_USE_EMULATORS=false
