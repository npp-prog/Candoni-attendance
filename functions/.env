# Copy to functions/.env (deployed with the functions; not a secret store).
# Region for all functions. Keep in sync with VITE_FUNCTIONS_REGION in the web app.
FUNCTIONS_REGION=asia-southeast1
# Set to "true" only after App Check is configured for the web app (see docs/SETUP.md).
ENFORCE_APP_CHECK=false
# Web app origins allowed for registered-phone passkeys (comma-separated). The
# passkey's relying party is the origin's hostname, so renaming the site requires
# adding the new origin here and re-registering phones.
WEBAUTHN_ORIGINS=http://localhost:5173
